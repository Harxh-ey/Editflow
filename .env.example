# ============================================================
# EditFlow Environment Variables
# ============================================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/editflow?retryWrites=true&w=majority

# AI Provider (Google AI Studio Gemma or OpenAI-compatible endpoint)
GEMMA_API_KEY=
GEMMA_MODEL=gemma-2-9b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ElevenLabs (optional voice input/output)
ELEVENLABS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
